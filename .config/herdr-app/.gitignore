# Nothing here is read by Herdr; it keeps yadm from tracking files the app
# owns. See AGENTS.md in this folder for who writes what.
# Yours: keys.json, settings.json, programs.json, layouts/<clones>.json,
# mods/<your mods>/, themes/<your themes>.json.

# rewritten on every start
AGENTS.md
*.d.ts
frame/
icons/
update-notes*
*.sock
*.error

# per-machine / per-installation state, written by Herdr
installed.json
seen.json
shared.json
view.json
window.json
windows.json
data/
layouts/.state/

# shipped layouts, restored by Herdr from its own copy
layouts/main.json
layouts/terminals.json
layouts/win98.json
layouts/win98.svg

# shipped themes, upgraded in place by Herdr
themes/atom-one-dark.json
themes/win98.json

# written into mod folders by gpui-shell
mods/*/jsconfig.json
mods/*/tsconfig.json
mods/*/*.d.ts

# shipped mods, replaced whole on every start
mods/agents/
mods/changes/
mods/confirm/
mods/files/
mods/help/
mods/machine-add/
mods/menu/
mods/new-menu/
mods/pane/
mods/peek/
mods/picker/
mods/prompt/
mods/spaces/
mods/tabs/
mods/terminals-bar/
mods/terminals-pane/
mods/toast/
mods/win98/
mods/workspace-chrome/
mods/workspace-status/
mods/worktree/
