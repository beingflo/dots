theme = 0x96f
cursor-color = #FFFFFF
cursor-style-blink = false
font-size = 15
macos-window-shadow = true
split-divider-color = #F0f0f0

# Tab Navigation
keybind = cmd+h=previous_tab
keybind = cmd+l=next_tab
keybind = cmd+k=goto_split:up
keybind = cmd+j=goto_split:down

# Creating Tabs and Grid Splits
keybind = cmd+shift+h=new_tab
keybind = cmd+shift+l=new_tab
keybind = cmd+shift+k=new_split:up
keybind = cmd+shift+j=new_split:down

# Equalize Layout Shortcut (Press this right after splitting to balance the space)
keybind = cmd+e=equalize_splits

keybind = cmd+enter=toggle_split_zoom

keybind = cmd+[=previous_tab
keybind = cmd+]=next_tab

keybind = option+backspace=text:\x1b\x7f

working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true

split-preserve-zoom = navigation

command = /opt/homebrew/bin/fish